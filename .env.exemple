ENVIRONMENT=development
DEBUG=true

POSTGRES_DRIVERNAME=postgresql+psycopg
POSTGRES_HOST=0.0.0.0
POSTGRES_PORT=5432
POSTGRES_USER=postgres # Superuser for initialization only
POSTGRES_PASSWORD=Passw0rd!
POSTGRES_DB=postgres

REDIS_HOST=0.0.0.0
REDIS_PORT=6379
REDIS_PASSWORD=Passw0rd!

ACCOUNTS_POSTGRES_USER=accounts
ACCOUNTS_POSTGRES_PASSWORD=Passw0rd!
ACCOUNTS_POSTGRES_DB=accounts
ACCOUNTS_POSTGRES_POOL_SIZE=5
ACCOUNTS_POSTGRES_MAX_OVERFLOW=10

ACCOUNTS_REDIS_PASSWORD=Passw0rd!
ACCOUNTS_REDIS_URL=redis://:${ACCOUNTS_REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

ACCOUNTS_JWT_SECRET=replace-with-a-long-random-string

AUTH_POSTGRES_USER=auth
AUTH_POSTGRES_PASSWORD=Passw0rd!
AUTH_POSTGRES_DB=auth
AUTH_POSTGRES_POOL_SIZE=5
AUTH_POSTGRES_MAX_OVERFLOW=10

AUTH_REDIS_PASSWORD=Passw0rd!
AUTH_REDIS_URL=redis://:${AUTH_REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

AUTH_JWT_SECRET=replace-with-a-long-random-string

PETS_POSTGRES_USER=pets
PETS_POSTGRES_PASSWORD=Passw0rd!
PETS_POSTGRES_DB=pets
PETS_POSTGRES_POOL_SIZE=10
PETS_POSTGRES_MAX_OVERFLOW=20

PETS_REDIS_PASSWORD=Passw0rd!
PETS_REDIS_URL=redis://:${PETS_REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

PETS_JWT_SECRET=replace-with-a-long-random-string

ACCOUNTS_SERVICE_HOST=0.0.0.0
ACCOUNTS_SERVICE_PORT=8001
AUTH_SERVICE_HOST=0.0.0.0
AUTH_SERVICE_PORT=8002
PETS_SERVICE_HOST=0.0.0.0
PETS_SERVICE_PORT=8003